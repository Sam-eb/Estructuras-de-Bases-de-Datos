raiz = generar_estudiantes_aleatorios()
todos = listar(raiz)
ids_buscar = random.sample([e["id"] for e in todos], 100)
print("Caso 1, estudiantes en orden aleatorio.")
print(f"🔎 Buscando {len(ids_buscar)} estudiantes aleatorios...\n")
busquedas_abb(raiz, ids_buscar)


todos = listar(raiz)
ids_buscar = random.sample([e["id"] for e in todos], 100)
print("Caso 2, estudiantes en orden.")
print(f"🔎 Buscando {len(ids_buscar)} estudiantes aleatorios...\n")
busquedas_abb(raiz, ids_buscar)