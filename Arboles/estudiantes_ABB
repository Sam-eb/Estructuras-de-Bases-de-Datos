# ── Buscar sin imprimir ───────────────────────────────────
def buscar_silencioso(nodo, id):
    if nodo is None:
        return None
    if id == nodo.estudiante["id"]:
        return nodo.estudiante
    if id < nodo.estudiante["id"]:
        return buscar_silencioso(nodo.izquierda, id)
    return buscar_silencioso(nodo.derecha, id)


# ── 100 búsquedas en ABB ──────────────────────────────────
def busquedas_abb(raiz, ids_buscar):
    inicio = time.time()
    for id in ids_buscar:
        buscar_silencioso(raiz, id)
    fin = time.time()
    print(f"⏱️  ABB  — 100 búsquedas en {fin - inicio:.6f} segundos")


